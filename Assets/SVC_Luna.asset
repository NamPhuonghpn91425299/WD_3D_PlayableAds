          FragmentProgram: "\n#version 100\n\n#ifdef GL_FRAGMENT_PRECISION_HIGH\n   
            precision highp float;\n#else\n    precision mediump float;\n#endif\nprecision
            highp int;\nuniform \tvec4 _LightDir;\nuniform \tfloat _DissolveCutout;\nuniform
            \tfloat _EdgeNoiseScale;\nuniform \tfloat _TestNoiseTex;\nuniform \tvec4
            _Color;\nuniform \tfloat _NormalStrength;\nuniform \tvec4 _AOColor;\nuniform
            \tfloat _DiffusePower;\nuniform \tvec4 _ShadowColor;\nuniform \tfloat
            _ShadowStrength;\nuniform \tfloat _ShadowExposure;\nuniform \tfloat _Display;\nuniform
            \tfloat _Brightness;\nuniform \tfloat _Saturation;\nuniform \tvec4 _DarkThreadColor;\nuniform
            \tfloat _DarkThreadThreshold;\nuniform \tfloat _DarkThreadSmoothness;\nuniform
            lowp sampler2D _MainTex;\nuniform lowp sampler2D _NormalMap;\nuniform
            lowp sampler2D _NoiseTex;\nvarying highp vec2 vs_TEXCOORD0;\nvarying
            highp vec2 vs_TEXCOORD1;\nvarying highp vec2 vs_TEXCOORD2;\nvarying highp
