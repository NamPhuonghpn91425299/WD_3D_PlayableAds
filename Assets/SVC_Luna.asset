            highp vec3 vs_TEXCOORD3;\nout highp vec3 vs_TEXCOORD4;\nout highp vec3
            vs_TEXCOORD5;\nout highp vec3 vs_TEXCOORD6;\nvec4 u_xlat0;\nvec4 u_xlat1;\nvec3
            u_xlat2;\nfloat u_xlat9;\nvoid main()\n{\n    vs_TEXCOORD0.xy = in_TEXCOORD0.xy
