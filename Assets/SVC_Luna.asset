            (-u_xlat2.xyz) + _SpecularColor.xyz;\n    u_xlat2.xyz = _SpecularColor.www
            * u_xlat3.xyz + u_xlat2.xyz;\n    u_xlat4.xyz = u_xlat4.xxx * u_xlat2.xyz;\n   
            u_xlat4.xyz = u_xlat4.xyz * vec3(vec3(_SpecularIntensity, _SpecularIntensity,
            _SpecularIntensity));\n    u_xlat2.xyz = vec3(_Metallic) * (-u_xlat1.xyz)
