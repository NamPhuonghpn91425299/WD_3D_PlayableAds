            = u_xlat0.xxx * in_NORMAL0.xyz;\n    u_xlat0.xyz = u_xlat0.xyz * vec3(_Threshold)
            + in_POSITION0.xyz;\n    u_xlatb12 = _ScaleFactor==0.0;\n    u_xlat12
            = (u_xlatb12) ? 1.0 : _ScaleFactor;\n    u_xlat0.xyz = vec3(u_xlat12)
            * u_xlat0.xyz;\n    u_xlat1 = u_xlat0.yyyy * hlslcc_mtx4x4unity_ObjectToWorld[1];\n   
            u_xlat1 = hlslcc_mtx4x4unity_ObjectToWorld[0] * u_xlat0.xxxx + u_xlat1;\n   
