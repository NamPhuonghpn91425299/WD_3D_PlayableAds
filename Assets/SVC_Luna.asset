            u_xlat5;\nfloat u_xlat10;\nfloat u_xlat15;\nfloat u_xlat16;\nvoid main()\n{\n   
            u_xlat0.x = dot(vs_TEXCOORD4.xyz, vs_TEXCOORD4.xyz);\n    u_xlat0.x =
