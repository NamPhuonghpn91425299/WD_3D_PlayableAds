            highp vec4 vs_TEXCOORD5;\nout highp vec4 vs_TEXCOORD6;\nvec4 u_xlat0;\nmediump
            vec4 u_xlat16_0;\nvec3 u_xlat1;\nvec4 u_xlat2;\nmediump float u_xlat16_3;\nmediump
            vec3 u_xlat16_4;\nfloat u_xlat15;\nfloat u_xlat16;\nvoid main()\n{\n   
