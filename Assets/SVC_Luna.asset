            = dot(_WorldSpaceLightPos0.xyz, u_xlat1.xyz);\n    u_xlat1.x = clamp(u_xlat1.x,
            0.0, 1.0);\n    u_xlat6 = (-_Glossiness) + 1.0;\n    u_xlat11 = u_xlat6
