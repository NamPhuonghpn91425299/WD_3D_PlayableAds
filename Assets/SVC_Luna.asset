            u_xlat27;\nmediump float u_xlat16_27;\nmediump float u_xlat16_28;\nmediump
            float u_xlat16_31;\nmediump float u_xlat16_33;\nvoid main()\n{\n    u_xlat0.x
            = dot(vs_TEXCOORD4.xyz, vs_TEXCOORD4.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
