            * in_POSITION0.zzz + u_xlat0.xyz;\n    u_xlat15 = _Time.y + _Time.y;\n   
            u_xlat15 = sin(u_xlat15);\n    u_xlat15 = u_xlat15 * 0.5 + 0.5;\n   
