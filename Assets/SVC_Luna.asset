            vs_TEXCOORD1.xyz = vec3(u_xlat6) * u_xlat0.xyz;\n    return;\n}\n\n"
          FragmentProgram: "\n#version 300 es\n\nprecision highp float;\nprecision
            highp int;\n#define HLSLCC_ENABLE_UNIFORM_BUFFERS 0\n#if HLSLCC_ENABLE_UNIFORM_BUFFERS\n#define
            UNITY_UNIFORM\n#else\n#define UNITY_UNIFORM uniform\n#endif\n#define
            UNITY_SUPPORTS_UNIFORM_LOCATION 0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define
            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec3 _WorldSpaceCameraPos;\nuniform
            \tvec4 _LightDir;\nuniform \tvec4 _Color;\nuniform \tfloat _Metallic;\nuniform
            \tfloat _Smoothness;\nuniform \tfloat _SpecularIntensity;\nuniform \tfloat
            _SpecularPower;\nuniform \tvec4 _SpecularColor;\nuniform \tfloat _LightIntensity;\nuniform
            \tfloat _AmbientIntensity;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _MainTex;\nin highp vec2 vs_TEXCOORD0;\nin highp vec3 vs_TEXCOORD1;\nin
            highp vec3 vs_TEXCOORD2;\nlayout(location = 0) out mediump vec4 SV_Target0;\nvec3
            u_xlat0;\nvec4 u_xlat1;\nmediump vec4 u_xlat16_1;\nvec3 u_xlat2;\nvec3
            u_xlat3;\nvec3 u_xlat4;\nfloat u_xlat8;\nfloat u_xlat12;\nvoid main()\n{\n   
            u_xlat0.x = dot(_LightDir.xyz, _LightDir.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n   
            u_xlat0.xyz = u_xlat0.xxx * _LightDir.xyz;\n    u_xlat1.xyz = (-vs_TEXCOORD2.xyz)
            + _WorldSpaceCameraPos.xyz;\n    u_xlat12 = dot(u_xlat1.xyz, u_xlat1.xyz);\n   
            u_xlat12 = inversesqrt(u_xlat12);\n    u_xlat1.xyz = u_xlat1.xyz * vec3(u_xlat12)
            + u_xlat0.xyz;\n    u_xlat12 = dot(u_xlat1.xyz, u_xlat1.xyz);\n    u_xlat12
            = inversesqrt(u_xlat12);\n    u_xlat1.xyz = vec3(u_xlat12) * u_xlat1.xyz;\n   
            u_xlat12 = dot(vs_TEXCOORD1.xyz, vs_TEXCOORD1.xyz);\n    u_xlat12 = inversesqrt(u_xlat12);\n   
            u_xlat2.xyz = vec3(u_xlat12) * vs_TEXCOORD1.xyz;\n    u_xlat12 = dot(u_xlat2.xyz,
            u_xlat1.xyz);\n    u_xlat12 = clamp(u_xlat12, 0.0, 1.0);\n    u_xlat0.x
            = dot(u_xlat2.xyz, u_xlat0.xyz);\n    u_xlat0.x = clamp(u_xlat0.x, 0.0,
            1.0);\n    u_xlat4.x = log2(u_xlat12);\n    u_xlat8 = _Smoothness * _SpecularPower;\n   
            u_xlat4.x = u_xlat4.x * u_xlat8;\n    u_xlat4.x = exp2(u_xlat4.x);\n   
            u_xlat16_1 = texture(_MainTex, vs_TEXCOORD0.xy);\n    u_xlat2.xyz = u_xlat16_1.xyz
            * _Color.xyz + vec3(-0.0399999991, -0.0399999991, -0.0399999991);\n   
            u_xlat1 = u_xlat16_1 * _Color;\n    u_xlat2.xyz = vec3(_Metallic) * u_xlat2.xyz
            + vec3(0.0399999991, 0.0399999991, 0.0399999991);\n    u_xlat3.xyz =
            (-u_xlat2.xyz) + _SpecularColor.xyz;\n    u_xlat2.xyz = _SpecularColor.www
            * u_xlat3.xyz + u_xlat2.xyz;\n    u_xlat4.xyz = u_xlat4.xxx * u_xlat2.xyz;\n   
            u_xlat4.xyz = u_xlat4.xyz * vec3(vec3(_SpecularIntensity, _SpecularIntensity,
            _SpecularIntensity));\n    u_xlat2.xyz = vec3(_Metallic) * (-u_xlat1.xyz)
            + u_xlat1.xyz;\n    u_xlat3.xyz = u_xlat0.xxx * u_xlat2.xyz;\n    u_xlat3.xyz
            = u_xlat3.xyz * vec3(_LightIntensity);\n    u_xlat2.xyz = u_xlat2.xyz
            * vec3(vec3(_AmbientIntensity, _AmbientIntensity, _AmbientIntensity))
            + u_xlat3.xyz;\n    u_xlat0.xyz = u_xlat4.xyz * vec3(_LightIntensity)
            + u_xlat2.xyz;\n    u_xlat2.xyz = u_xlat0.xyz * vec3(0.5, 0.5, 0.5) +
            vec3(1.0, 1.0, 1.0);\n    u_xlat1.xyz = u_xlat0.xyz / u_xlat2.xyz;\n   
            SV_Target0 = u_xlat1;\n    return;\n}\n\n"
