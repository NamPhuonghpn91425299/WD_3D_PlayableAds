            UNITY_SUPPORTS_UNIFORM_LOCATION 0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define
            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _LightDir;\nuniform \tvec4 _Color;\nuniform
            \tfloat _NormalStrength;\nuniform \tvec4 _AOColor;\nuniform \tfloat _DiffusePower;\nuniform
            \tvec4 _ShadowColor;\nuniform \tfloat _ShadowStrength;\nuniform \tfloat
            _ShadowExposure;\nuniform \tfloat _Brightness;\nuniform \tfloat _Saturation;\nuniform
            \tvec4 _DarkThreadColor;\nuniform \tfloat _DarkThreadThreshold;\nuniform
            \tfloat _DarkThreadSmoothness;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _MainTex;\nUNITY_LOCATION(1) uniform mediump sampler2D _NormalMap;\nin
            highp vec2 vs_TEXCOORD0;\nin highp vec2 vs_TEXCOORD1;\nin highp vec3
            vs_TEXCOORD3;\nin highp vec3 vs_TEXCOORD4;\nin highp vec3 vs_TEXCOORD5;\nlayout(location
            = 0) out highp vec4 SV_Target0;\nvec4 u_xlat0;\nvec4 u_xlat1;\nmediump
            vec4 u_xlat16_1;\nvec3 u_xlat2;\nmediump vec2 u_xlat16_2;\nmediump vec2
            u_xlat16_3;\nvec3 u_xlat4;\nfloat u_xlat5;\nfloat u_xlat10;\nfloat u_xlat15;\nfloat
            u_xlat16;\nvoid main()\n{\n    u_xlat0.x = dot(vs_TEXCOORD4.xyz, vs_TEXCOORD4.xyz);\n   
            u_xlat0.x = inversesqrt(u_xlat0.x);\n    u_xlat0.xyz = u_xlat0.xxx *
            vs_TEXCOORD4.xyz;\n    u_xlat15 = dot(vs_TEXCOORD5.xyz, vs_TEXCOORD5.xyz);\n   
            u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz = vec3(u_xlat15) *
            vs_TEXCOORD5.xyz;\n    u_xlat16_2.xy = texture(_NormalMap, vs_TEXCOORD1.xy).yw;\n   
            u_xlat16_3.xy = u_xlat16_2.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n   
            u_xlat1.xyz = u_xlat1.xyz * u_xlat16_3.yyy;\n    u_xlat0.xyz = u_xlat16_3.xxx
            * u_xlat0.xyz + u_xlat1.xyz;\n    u_xlat16_3.x = dot(u_xlat16_3.xy, u_xlat16_3.xy);\n   
            u_xlat16_3.x = min(u_xlat16_3.x, 1.0);\n    u_xlat16_3.x = (-u_xlat16_3.x)
            + 1.0;\n    u_xlat16_3.x = sqrt(u_xlat16_3.x);\n    u_xlat15 = dot(vs_TEXCOORD3.xyz,
            vs_TEXCOORD3.xyz);\n    u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz
            = vec3(u_xlat15) * vs_TEXCOORD3.xyz;\n    u_xlat0.xyz = u_xlat16_3.xxx
            * u_xlat1.xyz + u_xlat0.xyz;\n    u_xlat15 = dot(u_xlat0.xyz, u_xlat0.xyz);\n   
            u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat0.xyz = u_xlat0.xyz * vec3(u_xlat15)
            + (-vs_TEXCOORD3.xyz);\n    u_xlat0.xyz = vec3(_NormalStrength) * u_xlat0.xyz
            + vs_TEXCOORD3.xyz;\n    u_xlat15 = dot(u_xlat0.xyz, u_xlat0.xyz);\n   
            u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat0.xyz = vec3(u_xlat15) *
            u_xlat0.xyz;\n    u_xlat15 = dot(_LightDir.xyz, _LightDir.xyz);\n   
            u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz = vec3(u_xlat15) *
            _LightDir.xyz;\n    u_xlat0.x = dot(u_xlat0.xyz, u_xlat1.xyz);\n    u_xlat0.x
            = clamp(u_xlat0.x, 0.0, 1.0);\n    u_xlat5 = u_xlat0.x * _ShadowExposure;\n   
            u_xlat5 = clamp(u_xlat5, 0.0, 1.0);\n    u_xlat0.x = _DiffusePower *
            u_xlat0.x + 1.0;\n    u_xlat10 = _DarkThreadSmoothness + _DarkThreadThreshold;\n   
            u_xlat15 = (-_DarkThreadSmoothness) + _DarkThreadThreshold;\n    u_xlat10
            = (-u_xlat15) + u_xlat10;\n    u_xlat10 = float(1.0) / u_xlat10;\n   
            u_xlat16_1 = texture(_MainTex, vs_TEXCOORD0.xy);\n    u_xlat1 = u_xlat16_1
            * _Color;\n    u_xlat2.xyz = u_xlat1.www * _AOColor.xyz;\n    u_xlat4.xyz
            = u_xlat1.xyz * u_xlat2.xyz;\n    u_xlat1.xyz = (-u_xlat1.xyz) * u_xlat2.xyz
            + _DarkThreadColor.xyz;\n    SV_Target0.w = u_xlat1.w;\n    u_xlat16
            = dot(u_xlat4.xyz, vec3(0.298999995, 0.587000012, 0.114));\n    u_xlat15
            = (-u_xlat15) + u_xlat16;\n    u_xlat10 = u_xlat10 * u_xlat15;\n    u_xlat10
            = clamp(u_xlat10, 0.0, 1.0);\n    u_xlat15 = u_xlat10 * -2.0 + 3.0;\n   
            u_xlat10 = u_xlat10 * u_xlat10;\n    u_xlat10 = (-u_xlat15) * u_xlat10
            + 1.0;\n    u_xlat1.xyz = vec3(u_xlat10) * u_xlat1.xyz + u_xlat4.xyz;\n   
            u_xlat0.xzw = u_xlat0.xxx * u_xlat1.xyz;\n    u_xlat2.xyz = u_xlat1.xyz
            * _ShadowColor.xyz + (-u_xlat1.xyz);\n    u_xlat1.xyz = vec3(_ShadowStrength)
            * u_xlat2.xyz + u_xlat1.xyz;\n    u_xlat1.xyz = u_xlat1.xyz * vec3(vec3(_Brightness,
            _Brightness, _Brightness));\n    u_xlat0.xzw = u_xlat0.xzw * vec3(vec3(_Brightness,
            _Brightness, _Brightness)) + (-u_xlat1.xyz);\n    u_xlat0.xyz = vec3(u_xlat5)
            * u_xlat0.xzw + u_xlat1.xyz;\n    u_xlat15 = dot(u_xlat0.xyz, vec3(0.298999995,
            0.587000012, 0.114));\n    u_xlat0.xyz = (-vec3(u_xlat15)) + u_xlat0.xyz;\n   
            SV_Target0.xyz = vec3(vec3(_Saturation, _Saturation, _Saturation)) *
            u_xlat0.xyz + vec3(u_xlat15);\n    return;\n}\n\n"
