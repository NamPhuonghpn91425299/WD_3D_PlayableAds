            float u_xlat10_5;\nbool u_xlatb5;\nvec2 u_xlat10;\nbvec2 u_xlatb10;\nfloat
            u_xlat15;\nfloat u_xlat16;\nvoid main()\n{\n    u_xlat0.x = (-_Display)
            + 1.0;\n    u_xlat0.x = max(u_xlat0.x, 0.0);\n    u_xlat0.x = min(u_xlat0.x,
            _EdgeNoiseScale);\n    u_xlat5.x = (-u_xlat0.x) + _EdgeNoiseScale;\n   
            u_xlatb10.xy = greaterThanEqual(vec4(_DissolveCutout, _TestNoiseTex,
            _DissolveCutout, _TestNoiseTex), vec4(0.5, 0.5, 0.5, 0.5)).xy;\n    u_xlat10.x
            = u_xlatb10.x ? float(1.0) : 0.0;\n    u_xlat10.y = u_xlatb10.y ? float(1.0)
            : 0.0;\n;\n    u_xlat0.x = u_xlat10.y * u_xlat5.x + u_xlat0.x;\n    u_xlat5.xz
            = vs_TEXCOORD0.xy * vec2(5.0, 5.0);\n    u_xlat10_5 = texture2D(_NoiseTex,
            u_xlat5.xz).x;\n    u_xlat0.x = u_xlat0.x * u_xlat10_5;\n    u_xlat0.x
            = u_xlat10.x * u_xlat0.x + vs_TEXCOORD2.y;\n    u_xlat0.x = (-u_xlat0.x)
            + _Display;\n    u_xlatb5 = 0.949999988>=_Display;\n    u_xlat5.x = u_xlatb5
            ? 1.0 : float(0.0);\n    u_xlat0.x = u_xlat5.x * u_xlat0.x;\n    u_xlatb0
            = u_xlat0.x<0.0;\n    if(u_xlatb0){discard;}\n    u_xlat0.x = dot(vs_TEXCOORD4.xyz,
            vs_TEXCOORD4.xyz);\n    u_xlat0.x = inversesqrt(u_xlat0.x);\n    u_xlat0.xyz
            = u_xlat0.xxx * vs_TEXCOORD4.xyz;\n    u_xlat15 = dot(vs_TEXCOORD5.xyz,
            vs_TEXCOORD5.xyz);\n    u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz
            = vec3(u_xlat15) * vs_TEXCOORD5.xyz;\n    u_xlat10_2.xy = texture2D(_NormalMap,
            vs_TEXCOORD1.xy).yw;\n    u_xlat16_3.xy = u_xlat10_2.yx * vec2(2.0, 2.0)
            + vec2(-1.0, -1.0);\n    u_xlat1.xyz = u_xlat1.xyz * u_xlat16_3.yyy;\n   
            u_xlat0.xyz = u_xlat16_3.xxx * u_xlat0.xyz + u_xlat1.xyz;\n    u_xlat16_3.x
            = dot(u_xlat16_3.xy, u_xlat16_3.xy);\n    u_xlat16_3.x = min(u_xlat16_3.x,
            1.0);\n    u_xlat16_3.x = (-u_xlat16_3.x) + 1.0;\n    u_xlat16_3.x =
            sqrt(u_xlat16_3.x);\n    u_xlat15 = dot(vs_TEXCOORD3.xyz, vs_TEXCOORD3.xyz);\n   
            u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz = vec3(u_xlat15) *
            vs_TEXCOORD3.xyz;\n    u_xlat0.xyz = u_xlat16_3.xxx * u_xlat1.xyz + u_xlat0.xyz;\n   
            u_xlat15 = dot(u_xlat0.xyz, u_xlat0.xyz);\n    u_xlat15 = inversesqrt(u_xlat15);\n   
            u_xlat0.xyz = u_xlat0.xyz * vec3(u_xlat15) + (-vs_TEXCOORD3.xyz);\n   
