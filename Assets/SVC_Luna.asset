            + 1.0;\n    u_xlat16_25 = log2(u_xlat16_25);\n    u_xlat16_25 = u_xlat16_25
            * unity_SpecCube0_HDR.y;\n    u_xlat16_25 = exp2(u_xlat16_25);\n    u_xlat16_25
