            u_xlat2;\nvec3 u_xlat3;\nvec3 u_xlat4;\nfloat u_xlat8;\nfloat u_xlat12;\nvoid
            main()\n{\n    u_xlat0.x = dot(_LightDir.xyz, _LightDir.xyz);\n    u_xlat0.x
            = inversesqrt(u_xlat0.x);\n    u_xlat0.xyz = u_xlat0.xxx * _LightDir.xyz;\n   
            u_xlat1.xyz = (-vs_TEXCOORD2.xyz) + _WorldSpaceCameraPos.xyz;\n    u_xlat12
            = dot(u_xlat1.xyz, u_xlat1.xyz);\n    u_xlat12 = inversesqrt(u_xlat12);\n   
            u_xlat1.xyz = u_xlat1.xyz * vec3(u_xlat12) + u_xlat0.xyz;\n    u_xlat12
            = dot(u_xlat1.xyz, u_xlat1.xyz);\n    u_xlat12 = inversesqrt(u_xlat12);\n   
            u_xlat1.xyz = vec3(u_xlat12) * u_xlat1.xyz;\n    u_xlat12 = dot(vs_TEXCOORD1.xyz,
            vs_TEXCOORD1.xyz);\n    u_xlat12 = inversesqrt(u_xlat12);\n    u_xlat2.xyz
            = vec3(u_xlat12) * vs_TEXCOORD1.xyz;\n    u_xlat12 = dot(u_xlat2.xyz,
            u_xlat1.xyz);\n    u_xlat12 = clamp(u_xlat12, 0.0, 1.0);\n    u_xlat0.x
            = dot(u_xlat2.xyz, u_xlat0.xyz);\n    u_xlat0.x = clamp(u_xlat0.x, 0.0,
