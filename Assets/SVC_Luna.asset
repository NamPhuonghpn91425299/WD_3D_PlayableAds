            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _LightDir;\nuniform \tfloat _DissolveCutout;\nuniform
            \tfloat _EdgeNoiseScale;\nuniform \tfloat _TestNoiseTex;\nuniform \tvec4
            _Color;\nuniform \tfloat _NormalStrength;\nuniform \tvec4 _AOColor;\nuniform
            \tfloat _DiffusePower;\nuniform \tvec4 _ShadowColor;\nuniform \tfloat
            _ShadowStrength;\nuniform \tfloat _ShadowExposure;\nuniform \tfloat _Display;\nuniform
            \tfloat _Brightness;\nuniform \tfloat _Saturation;\nuniform \tvec4 _DarkThreadColor;\nuniform
            \tfloat _DarkThreadThreshold;\nuniform \tfloat _DarkThreadSmoothness;\nUNITY_LOCATION(0)
            uniform mediump sampler2D _MainTex;\nUNITY_LOCATION(1) uniform mediump
            sampler2D _NormalMap;\nUNITY_LOCATION(2) uniform mediump sampler2D _NoiseTex;\nin
            highp vec2 vs_TEXCOORD0;\nin highp vec2 vs_TEXCOORD1;\nin highp vec2
            vs_TEXCOORD2;\nin highp vec3 vs_TEXCOORD3;\nin highp vec3 vs_TEXCOORD4;\nin
            highp vec3 vs_TEXCOORD5;\nlayout(location = 0) out highp vec4 SV_Target0;\nvec4
            u_xlat0;\nbool u_xlatb0;\nvec4 u_xlat1;\nmediump vec4 u_xlat16_1;\nvec3
            u_xlat2;\nmediump vec2 u_xlat16_2;\nmediump vec2 u_xlat16_3;\nvec3 u_xlat4;\nvec3
            u_xlat5;\nmediump float u_xlat16_5;\nbool u_xlatb5;\nvec2 u_xlat10;\nbvec2
            u_xlatb10;\nfloat u_xlat15;\nfloat u_xlat16;\nvoid main()\n{\n    u_xlat0.x
            = (-_Display) + 1.0;\n    u_xlat0.x = max(u_xlat0.x, 0.0);\n    u_xlat0.x
