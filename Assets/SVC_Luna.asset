            = texture(unity_NHxRoughness, u_xlat0.xy).x;\n    u_xlat16_25 = u_xlat0.x
            * 0.639999986;\n    u_xlat16_0 = texture(_MainTex, vs_TEXCOORD0.xy);\n   
            u_xlat16_7.xyz = u_xlat16_0.xyz * vec3(0.959999979, 0.959999979, 0.959999979)
            + vec3(u_xlat16_25);\n    u_xlat16_4.xyz = u_xlat16_7.xyz * u_xlat16_6.xyz
            + u_xlat16_4.xyz;\n    u_xlat0.x = dot(u_xlat16_1.xyz, u_xlat16_1.xyz);\n   
            u_xlat0.x = inversesqrt(u_xlat0.x);\n    u_xlat0.xyz = u_xlat0.xxx *
            u_xlat16_1.xyz;\n    u_xlat5.xyz = u_xlat2.yyy * vs_TEXCOORD2.xyz;\n   
            u_xlat2.xyw = vs_TEXCOORD1.xyz * u_xlat2.xxx + u_xlat5.xyz;\n    u_xlat2.xyz
            = vs_TEXCOORD3.xyz * u_xlat2.zzz + u_xlat2.xyw;\n    u_xlat26 = dot(u_xlat2.xyz,
            u_xlat2.xyz);\n    u_xlat26 = inversesqrt(u_xlat26);\n    u_xlat2.xyz
            = vec3(u_xlat26) * u_xlat2.xyz;\n    u_xlat0.x = dot(u_xlat0.xyz, u_xlat2.xyz);\n   
            u_xlat0.x = clamp(u_xlat0.x, 0.0, 1.0);\n    u_xlat0.x = (-u_xlat0.x)
            + 1.0;\n    u_xlat0.x = log2(u_xlat0.x);\n    u_xlat0.x = u_xlat0.x *
            _FresnelPower;\n    u_xlat0.x = exp2(u_xlat0.x);\n    SV_Target0.xyz
            = _FresnelColor.xyz * u_xlat0.xxx + u_xlat16_4.xyz;\n    u_xlat0.x =
            min(u_xlat0.x, 1.0);\n    u_xlat0.x = u_xlat0.x * u_xlat16_0.w;\n   
            SV_Target0.w = u_xlat0.x;\n    return;\n}\n\n"
