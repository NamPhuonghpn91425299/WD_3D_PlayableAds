          FragmentProgram: "\n#version 300 es\n\nprecision highp float;\nprecision
            highp int;\n#define HLSLCC_ENABLE_UNIFORM_BUFFERS 0\n#if HLSLCC_ENABLE_UNIFORM_BUFFERS\n#define
            UNITY_UNIFORM\n#else\n#define UNITY_UNIFORM uniform\n#endif\n#define
            UNITY_SUPPORTS_UNIFORM_LOCATION 0\n#if UNITY_SUPPORTS_UNIFORM_LOCATION\n#define
            UNITY_LOCATION(x) layout(location = x)\n#define UNITY_BINDING(x) layout(binding
            = x, std140)\n#else\n#define UNITY_LOCATION(x)\n#define UNITY_BINDING(x)
            layout(std140)\n#endif\nuniform \tvec4 _Time;\nuniform \tvec4 _Color;\nuniform
            \tvec4 _AOColor;\nuniform \tfloat _Amplitude;\nuniform \tfloat _Frequency;\nuniform
            \tfloat _Speed;\nuniform \tfloat _WaveWidth;\nuniform \tfloat _Display;\nuniform
            \tfloat _Brightness;\nuniform \tfloat _Ambient;\nuniform \tfloat _DiffusePower;\nuniform
            \tvec4 _LightDir;\nuniform \tvec4 _ShadowColor;\nuniform \tfloat _ShadowStrength;\nuniform
            \tfloat _ShadowExposure;\nUNITY_LOCATION(0) uniform mediump sampler2D
            _MainTex;\nin highp vec2 vs_TEXCOORD0;\nin highp vec2 vs_TEXCOORD2;\nlayout(location
            = 0) out mediump vec4 SV_Target0;\nvec4 u_xlat0;\nvec4 u_xlat1;\nmediump
            vec4 u_xlat16_1;\nmediump vec3 u_xlat16_2;\nfloat u_xlat3;\nfloat u_xlat4;\nvec3
            u_xlat7;\nvec2 u_xlat8;\nfloat u_xlat12;\nbool u_xlatb12;\nvoid main()\n{\n   
            u_xlat0.x = _Time.y * _Speed + vs_TEXCOORD2.x;\n    u_xlat0.x = u_xlat0.x
            * _Frequency;\n    u_xlat0.x = u_xlat0.x * 6.28310013;\n    u_xlat0.x
            = sin(u_xlat0.x);\n    u_xlat0.x = u_xlat0.x * _Amplitude;\n    u_xlat4
            = vs_TEXCOORD2.x * 3.1415925;\n    u_xlat4 = sin(u_xlat4);\n    u_xlat8.xy
            = vs_TEXCOORD2.yx + vec2(-0.5, -0.5);\n    u_xlat8.x = (-u_xlat0.x) *
            u_xlat4 + u_xlat8.x;\n    u_xlat0.x = u_xlat4 * u_xlat0.x;\n    u_xlat0.y
            = u_xlat0.x * 0.5 + vs_TEXCOORD0.y;\n    u_xlat12 = -abs(u_xlat8.y) +
            1.0;\n    u_xlat1.x = _WaveWidth * u_xlat12 + -abs(u_xlat8.x);\n    u_xlat12
            = u_xlat12 * _WaveWidth;\n    u_xlat8.x = abs(u_xlat8.x) / u_xlat12;\n   
            u_xlat8.x = (-u_xlat8.x) + 1.0;\n    u_xlat8.x = u_xlat8.x * 0.5 + 0.5;\n   
            u_xlat8.x = u_xlat8.x + u_xlat8.x;\n    u_xlatb12 = u_xlat1.x<0.0;\n   
            if(u_xlatb12){discard;}\n    u_xlat12 = (-vs_TEXCOORD2.x) + _Display;\n   
            u_xlatb12 = u_xlat12<0.0;\n    if(u_xlatb12){discard;}\n    u_xlat0.x
            = vs_TEXCOORD2.x * 0.25 + 0.375;\n    u_xlat16_1 = texture(_MainTex,
            u_xlat0.xy);\n    u_xlat1 = u_xlat16_1 * _Color;\n    u_xlat0.xyw = u_xlat1.www
            * _AOColor.xyz;\n    u_xlat16_2.xyz = u_xlat0.xyw * u_xlat1.xyz;\n   
            u_xlat0.xyw = u_xlat16_2.xyz * _ShadowColor.xyz + (-u_xlat16_2.xyz);\n   
            u_xlat0.xyw = vec3(_ShadowStrength) * u_xlat0.xyw + u_xlat16_2.xyz;\n   
            u_xlat0.xyw = u_xlat0.xyw * vec3(vec3(_Brightness, _Brightness, _Brightness));\n   
            u_xlat3 = dot(_LightDir.xyz, _LightDir.xyz);\n    u_xlat3 = inversesqrt(u_xlat3);\n   
            u_xlat3 = u_xlat3 * _LightDir.z;\n    u_xlat3 = clamp(u_xlat3, 0.0, 1.0);\n   
            u_xlat7.x = _DiffusePower * u_xlat3 + _Ambient;\n    u_xlat3 = u_xlat3
            * _ShadowExposure;\n    u_xlat3 = clamp(u_xlat3, 0.0, 1.0);\n    u_xlat7.xyz
            = u_xlat16_2.xyz * u_xlat7.xxx;\n    u_xlat16_2.xyz = u_xlat7.xyz * vec3(vec3(_Brightness,
            _Brightness, _Brightness)) + (-u_xlat0.xyw);\n    u_xlat16_2.xyz = vec3(u_xlat3)
            * u_xlat16_2.xyz + u_xlat0.xyw;\n    u_xlat1.xyz = u_xlat8.xxx * u_xlat16_2.xyz;\n   
            SV_Target0 = u_xlat1;\n    return;\n}\n\n"
