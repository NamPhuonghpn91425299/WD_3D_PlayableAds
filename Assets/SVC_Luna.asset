            = vs_TEXCOORD2.w;\n    u_xlat3.y = vs_TEXCOORD3.w;\n    u_xlat3.z = vs_TEXCOORD4.w;\n   
            u_xlat4.xyz = (-vs_TEXCOORD1.xyz) * vec3(u_xlat18) + u_xlat3.xyz;\n   
