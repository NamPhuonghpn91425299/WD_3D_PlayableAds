            u_xlat16;\nfloat u_xlat24;\nmediump float u_xlat16_25;\nfloat u_xlat26;\nvoid
            main()\n{\n    u_xlat16_0.xy = texture(_NormalMap, vs_TEXCOORD0.zw).yw;\n   
            u_xlat16_1.xy = u_xlat16_0.yx * vec2(2.0, 2.0) + vec2(-1.0, -1.0);\n   
            u_xlat16_25 = dot(u_xlat16_1.xy, u_xlat16_1.xy);\n    u_xlat16_25 = min(u_xlat16_25,
            1.0);\n    u_xlat16_25 = (-u_xlat16_25) + 1.0;\n    u_xlat16_1.z = sqrt(u_xlat16_25);\n   
            u_xlat0.x = dot(vs_TEXCOORD1.xyz, u_xlat16_1.xyz);\n    u_xlat0.y = dot(vs_TEXCOORD2.xyz,
            u_xlat16_1.xyz);\n    u_xlat0.z = dot(vs_TEXCOORD3.xyz, u_xlat16_1.xyz);\n   
