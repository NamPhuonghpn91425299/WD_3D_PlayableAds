            * _NormalMap_ST.xy + _NormalMap_ST.zw;\n    vs_TEXCOORD2.xy = in_TEXCOORD1.xy;\n   
            u_xlat0.x = dot(in_NORMAL0.xyz, hlslcc_mtx4x4unity_WorldToObject[0].xyz);\n   
