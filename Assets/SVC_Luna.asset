            * u_xlat2.xyz + _DarkThreadColor.xyz;\n    SV_Target0.w = u_xlat1.w;\n   
            u_xlat16 = dot(u_xlat4.xyz, vec3(0.298999995, 0.587000012, 0.114));\n   
