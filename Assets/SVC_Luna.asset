            _ShadowExposure;\n    u_xlat5.x = clamp(u_xlat5.x, 0.0, 1.0);\n    u_xlat0.x
            = _DiffusePower * u_xlat0.x + 1.0;\n    u_xlat10.x = _DarkThreadSmoothness
            + _DarkThreadThreshold;\n    u_xlat15 = (-_DarkThreadSmoothness) + _DarkThreadThreshold;\n   
            u_xlat10.x = (-u_xlat15) + u_xlat10.x;\n    u_xlat10.x = float(1.0) /
            u_xlat10.x;\n    u_xlat16_1 = texture(_MainTex, vs_TEXCOORD0.xy);\n   
            u_xlat1 = u_xlat16_1 * _Color;\n    u_xlat2.xyz = u_xlat1.www * _AOColor.xyz;\n   
