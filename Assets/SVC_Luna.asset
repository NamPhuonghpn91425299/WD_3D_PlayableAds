            u_xlat10.x = clamp(u_xlat10.x, 0.0, 1.0);\n    u_xlat15 = u_xlat10.x
            * -2.0 + 3.0;\n    u_xlat10.x = u_xlat10.x * u_xlat10.x;\n    u_xlat10.x
            = (-u_xlat15) * u_xlat10.x + 1.0;\n    u_xlat1.xyz = u_xlat10.xxx * u_xlat1.xyz
            + u_xlat4.xyz;\n    u_xlat0.xzw = u_xlat0.xxx * u_xlat1.xyz;\n    u_xlat2.xyz
            = u_xlat1.xyz * _ShadowColor.xyz + (-u_xlat1.xyz);\n    u_xlat1.xyz =
            vec3(_ShadowStrength) * u_xlat2.xyz + u_xlat1.xyz;\n    u_xlat1.xyz =
            u_xlat1.xyz * vec3(vec3(_Brightness, _Brightness, _Brightness));\n   
            u_xlat0.xzw = u_xlat0.xzw * vec3(vec3(_Brightness, _Brightness, _Brightness))
            + (-u_xlat1.xyz);\n    u_xlat0.xyz = u_xlat5.xxx * u_xlat0.xzw + u_xlat1.xyz;\n   
            u_xlat15 = dot(u_xlat0.xyz, vec3(0.298999995, 0.587000012, 0.114));\n   
            u_xlat0.xyz = (-vec3(u_xlat15)) + u_xlat0.xyz;\n    SV_Target0.xyz =
            vec3(_Saturation) * u_xlat0.xyz + vec3(u_xlat15);\n    return;\n}\n\n"
