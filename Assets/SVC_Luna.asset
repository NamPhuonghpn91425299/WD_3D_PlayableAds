            * _ShadowColor.xyz + (-u_xlat1.xyz);\n    u_xlat1.xyz = vec3(_ShadowStrength)
            * u_xlat2.xyz + u_xlat1.xyz;\n    u_xlat1.xyz = u_xlat1.xyz * vec3(vec3(_Brightness,
            _Brightness, _Brightness));\n    u_xlat0.xzw = u_xlat0.xzw * vec3(vec3(_Brightness,
