            = u_xlat0.xxx * vs_TEXCOORD4.xyz;\n    u_xlat15 = dot(vs_TEXCOORD5.xyz,
            vs_TEXCOORD5.xyz);\n    u_xlat15 = inversesqrt(u_xlat15);\n    u_xlat1.xyz
            = vec3(u_xlat15) * vs_TEXCOORD5.xyz;\n    u_xlat16_2.xy = texture(_NormalMap,
