            = u_xlat0.xxx * u_xlat16_8.xyz + u_xlat16_9.xyz;\n    u_xlat16_4.xyz
            = u_xlat16_4.xyz * u_xlat16_10.xyz;\n    u_xlat16_4.xyz = u_xlat16_5.xyz
            * u_xlat16_9.xyz + u_xlat16_4.xyz;\n    u_xlat16_4.xyz = u_xlat16_8.xyz
