      \uB2F9\uACA8\uBD10\uC694, \uAE30\uBD84 \uC88B\uC544\uC838\uC694!\t\U0001F9F6
      \u7CF8\u3092\u3061\u3087\u3063\u3068\u5F15\u3051\u3070\u3001\u30CF\u30C3\u30D4\u30FC\u306B\u306A\u308C\u308B\u3088\uFF01\t\U0001F9F6
      \u0925\u094B\u0921\u093C\u093E \u0927\u093E\u0917\u093E \u0916\u0940\u0902\u091A\u094B,
      \u0916\u0941\u0936 \u0939\u094B \u091C\u093E\u0913!\t\U0001F9F6 \u041F\u043E\u0442\u044F\u0433\u043D\u0438
      \u043D\u0438\u0442\u043E\u0447\u043A\u0443 \u2014 \u0456 \u043D\u0430\u0441\u0442\u0440\u0456\u0439
      \u043F\u0456\u0434\u0435 \u0432\u0433\u043E\u0440\u0443!\t\U0001F9F6 Tira un
      filo e senti la gioia!\r\nntf_mes_2\t\U0001F60F Miss your speedy hands\u2014come
      prove it again!\t\U0001F60F Tui nh\u1EDB b\u1EA1n g\u1EE1 len si\xEAu nhanh,
      quay l\u1EA1i ch\u1EE9ng minh coi!\t\U0001F60F Saudades dos seus toques r\xE1pidos\u2014volta
      logo!\t\U0001F60F H\u0131zl\u0131 \xE7\xF6zmelerini \xF6zledik\u2014geri gel
      de g\xF6ster!\t\U0001F60F Deine schnellen Z\xFCge fehlen\u2014zeig, was du
      drauf hast!\t\U0001F60F Tes gestes rapides nous manquent\u2014reviens prouver
      ton talent !\t\U0001F60F Kangen tarik cepatmu\u2014ayo buktikan lagi!\t\U0001F60F
      Extra\xF1amos tus manos r\xE1pidas\u2014\xA1vuelve y demu\xE9stralo!\t\U0001F60F
      \u0421\u043A\u0443\u0447\u0430\u0435\u043C \u043F\u043E \u0442\u0432\u043E\u0435\u0439
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u2014 \u0432\u0435\u0440\u043D\u0438\u0441\u044C
      \u0438 \u0434\u043E\u043A\u0430\u0436\u0438!\t\U0001F60F \uB2F9\uC2E0\uC758
      \uBE60\uB978 \uC190\uB180\uB9BC\uC774 \uADF8\uB9AC\uC6CC\uC694\u2014\uB2E4\uC2DC
      \uBCF4\uC5EC\uC918\uC694!\t\U0001F60F \u3042\u306A\u305F\u306E\u65E9\u30EF\u30B6\u304C\u604B\u3057\u3044\u301C\u623B\u3063\u3066\u304D\u3066\u898B\u305B\u3066\uFF01\t\U0001F60F
      \u0924\u0941\u092E\u094D\u0939\u093E\u0930\u0940 \u0938\u094D\u092A\u0940\u0921
      \u092E\u093F\u0938 \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902\u2014\u091C\u0932\u094D\u0926\u0940
      \u0906\u0913, \u0926\u093F\u0916\u093E\u0913!\t\U0001F60F \u0421\u0443\u043C\u0443\u0454\u043C\u043E
      \u0437\u0430 \u0442\u0432\u043E\u0454\u044E \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044E
